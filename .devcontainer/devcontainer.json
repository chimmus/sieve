{
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "initializeCommand": "gh auth token | podman secret create --replace gh_token -",
  "runArgs": ["--secret=gh_token"],
  "postCreateCommand": "scripts/setup",
  "remoteEnv": {
    "REMOTE_CONTAINERS": "true"
  }
}
